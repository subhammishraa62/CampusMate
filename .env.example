# Copy this file to .env.local. Never commit .env.local.

# Supabase: optional for local-first mode; required for accounts and persistent cloud tasks.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is supported if your dashboard still labels it that way:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Amazon Bedrock: server-side only. The AWS SDK uses the normal credential provider chain.
# Nova 2 Lite uses a Global cross-Region inference profile from Mumbai. Requests may be routed to supported AWS Regions worldwide.
# If strict data residency is required, do not use this Global profile; select a model/profile with suitable routing guarantees.
# Configure AWS CLI / IAM Identity Center, then enable Bedrock below.
# On AWS hosting, prefer an IAM role with bedrock:InvokeModel permission over long-lived keys.
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_ENABLED=false
# Do NOT prefix AWS credentials with NEXT_PUBLIC_. Prefer AWS CLI credentials/IAM roles.
# Optional only if you are explicitly using environment credentials:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=default

# Alexa+ track: self-hosted MCP endpoint is /api/mcp using Streamable HTTP.
# Leave blank for localhost-only development. In production, set a long random token.
CAMPUSMATE_MCP_TOKEN=
# Comma-separated hostnames/origin hostnames to admit in production, e.g. campusmate.example.com
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
# Optional public origin for constructing server-side MCP client URLs in unusual proxy deployments.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
